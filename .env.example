# Hugging Face token with Write access (for the private model repo and for publishing).
# Read by docker compose and passed to the api and worker containers only.
HUGGING_FACE_TOKEN=

# Running the Python code outside Docker (docker compose sets these itself):
# DATABASE_URL=postgresql+psycopg://toxic:toxic@localhost:5432/toxic

# Pin a model version for inference (default: newest in model_registry/)
# TOXIC_MODEL_VERSION=v20261027_1608

# Docker only: change a port if it is already taken
# API_PORT=8000
# ADMIN_PORT=3000
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# If the API is reached on another address, rebuild the admin after changing this:
# PUBLIC_API_URL=http://localhost:8000
